# Copy this file to .env and fill in the values. .env is gitignored — never commit real keys.
#
# After editing .env, restart Metro with --reset-cache. react-native-dotenv inlines
# these values when the bundle is transformed, so a stale key otherwise survives.

# Google Maps browser key, used by src/api/config.tsx.
#
# This is a *browser* key: every map in this app is a WebView loading the Maps
# JavaScript API, so restrict it in Google Cloud Console by HTTP referrer — never
# by Android package + SHA-1, which only applies to the native Maps SDK this app
# does not use.
#
#   APIs to allow : Maps JavaScript API, Places API, Geocoding API, Directions API
#   Referrers     : https://fieldnova.com/*
#
# The key ships inside the app bundle and is extractable by design, so also set
# per-API daily quota caps and a billing budget alert. Those are the real control.
GOOGLE_MAP_KEY=

# OpenRouteService key, used for route geometry on the active-ride map
# (src/screen/home/ride). Get one at https://openrouteservice.org.
#
# This one is a genuine private credential: ORS supports no referrer, IP or
# package restriction at all, and quotas are per account. It is currently
# interpolated into WebView HTML, so it still ships to the device — the durable
# fix is to proxy ORS through the Laravel backend. Until then, treat any key
# that has ever been committed as burned and reissue it.
ORS_API_KEY=
